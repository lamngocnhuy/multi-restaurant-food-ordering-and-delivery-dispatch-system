# Generate a ready-to-run .env with: python3 scripts/configure.py
# Never commit .env. Keep these secrets in your deployment secret store.
POSTGRES_DB=gather
POSTGRES_USER=gather
POSTGRES_PASSWORD=
DATABASE_URL=postgresql+psycopg://gather:CHANGE_PASSWORD@localhost:5432/gather
SECRET_KEY=
PAYMENT_CALLBACK_SECRET=

APP_ENV=development
APP_PORT=8000
BASE_URL=http://localhost:8000
TRUSTED_HOSTS=localhost,127.0.0.1,testserver
COOKIE_SECURE=false
ENABLE_SCHEDULER=true
PAYMENT_PROVIDER=sandbox
SEED_DEMO=true
DEMO_PASSWORD=Demo123!

# Required when enabling the public TLS profile; use your real domain/email.
PUBLIC_HOST=localhost
TLS_EMAIL=
